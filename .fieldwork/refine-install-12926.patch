+/// Copy one source into a multi-source target directory and track whether this
+/// invocation created the destination name.
+fn copy_into_dir_entry(
+    from: &Path,
+    to: &Path,
+    b: &Behavior,
+    copied_destinations: &mut HashSet<PathBuf>,
+) -> UResult<()> {
+    if b.compare && !need_copy(from, to, b) {
+        return Ok(());
+    }
+
+    let backup_path = perform_backup(from, to, b)?;
+    copy_file(from, to)?;
+
+    // Destination ownership begins when the data copy creates the file, before
+    // post-copy metadata operations. A failed chown must still protect that
+    // file from a later same-name source in this invocation.
+    copied_destinations.insert(to.to_path_buf());
+
+    let result = finalize_installed_file(from, to, b, backup_path);
+
+    // strip_file removes the destination when stripping fails. In that case
+    // there is no just-created name left to protect, so a later source may use
+    // it. Keep ownership for other failures that leave the destination present.
+    if result.is_err()
+        && matches!(
+            fs::symlink_metadata(to),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound
+        )
+    {
+        copied_destinations.remove(to);
+    }
+
+    result
+}
 
